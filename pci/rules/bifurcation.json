{
  "domain": "bifurcation",
  "version": "2.0.0",
  "last_reviewed": "2025-01",
  "sources": ["EBC 2022", "ESC 2024", "DKCRUSH-V"],
  "rules": [
    {
      "id": "bif-wire-jailing",
      "domain": "bifurcation",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "Wire both branches before stenting. Jailed SB wire technique protects against abrupt SB closure. Optional for SB <2mm.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "bif-provisional-default",
      "domain": "bifurcation",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "Provisional single-stent strategy is the default. Upfront 2-stent only when SB >2.5mm AND Medina SB=1.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": "I", "level": "A" },
      "active": true
    },
    {
      "id": "bif-pot-mandatory",
      "domain": "bifurcation",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "POT mandatory immediately after MV stent deployment (short NC balloon, carina as distal marker). rePOT mandatory after any SB balloon inflation.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "bif-sb-rewire-proximal-cell",
      "domain": "bifurcation",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "Re-wire SB through the proximal stent cell after MV deployment. Confirm wire position in distal SB with contrast before balloon inflation.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": null, "level": null },
      "active": true
    },
    {
      "id": "bif-kbi-threshold",
      "domain": "bifurcation",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "KBI only if: SB TIMI <3, residual SB ostial stenosis >75%, or significant SB ostial dissection. Routine KBI is not recommended.",
      "caution": "Do not perform routine KBI — reserved for the rescue indications above only.",
      "evidence": { "source": "EBC", "year": 2022, "class": "III", "level": "B" },
      "active": true
    },
    {
      "id": "bif-2stent-indication",
      "domain": "bifurcation",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" },
        { "field": "sb_large", "op": "is_true" },
        { "field": "sb_ostial", "op": "is_true" }
      ],
      "action": "Upfront 2-stent indicated. DK-Crush preferred for most anatomies (DKCRUSH-V); Culotte for equal-calibre vessels with non-acute angle. FKBI mandatory.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": "IIa", "level": "A" },
      "active": true
    },
    {
      "id": "bif-fkbi-mandatory",
      "domain": "bifurcation",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" },
        { "field": "sb_large", "op": "is_true" },
        { "field": "sb_ostial", "op": "is_true" }
      ],
      "action": "FKBI mandatory after all 2-stent techniques. Both balloons simultaneously; align markers at the carina.",
      "caution": "Failure to perform FKBI after 2-stent techniques is associated with significantly higher MACE.",
      "evidence": { "source": "EBC", "year": 2022, "class": "I", "level": "A" },
      "active": true
    },
    {
      "id": "bif-dkcrush-acute-angle",
      "domain": "bifurcation",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" },
        { "field": "sb_large", "op": "is_true" },
        { "field": "sb_ostial", "op": "is_true" },
        { "field": "bifurcation.sb_angle", "op": "eq", "value": "acute" }
      ],
      "action": "DK-Crush strongly favoured for acute SB angle (<45°). Re-wire through proximal cell after crushing — inadvertent distal cell entry compromises first kissing balloon.",
      "caution": "Culotte is technically challenging with acute-angle bifurcations.",
      "evidence": { "source": "EBC", "year": 2022, "class": "IIa", "level": "A" },
      "active": true
    },
    {
      "id": "bif-culotte-obtuse-angle",
      "domain": "bifurcation",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" },
        { "field": "sb_large", "op": "is_true" },
        { "field": "sb_ostial", "op": "is_true" },
        { "field": "bifurcation.sb_angle", "op": "eq", "value": "obtuse" }
      ],
      "action": "Culotte favourable for obtuse SB angle (>70°) with similar-calibre branches. DK-Crush remains acceptable. FKBI mandatory.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": null, "level": null },
      "active": true
    }
  ]
}
