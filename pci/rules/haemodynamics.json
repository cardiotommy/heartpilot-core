{
  "domain": "haemodynamics",
  "version": "2.0.0",
  "last_reviewed": "2025-01",
  "sources": ["ESC 2024", "ACC/AHA/SCAI 2021", "CULPRIT-SHOCK"],
  "rules": [
    {
      "id": "haem-culprit-only-shock",
      "domain": "haemodynamics",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "haem_status", "op": "eq", "value": "compromised" },
        { "field": "multivessel", "op": "is_true" }
      ],
      "action": "Treat culprit lesion only in the acute setting. Stage non-culprit vessels after haemodynamic stabilisation. Minimise contrast and inflation times.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "III", "level": "A" },
      "active": true
    },
    {
      "id": "haem-mcs-last-vessel-seveef",
      "domain": "haemodynamics",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "last_remaining_vessel", "op": "is_true" },
        { "field": "lvef_severe", "op": "is_true" }
      ],
      "action": "Prophylactic MCS strongly recommended before wiring. Microaxial pump preferred over IABP. Confirm cardiac surgical backup.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "haem-mcs-last-vessel-compromised",
      "domain": "haemodynamics",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "last_remaining_vessel", "op": "is_true" },
        { "field": "haem_status", "op": "eq", "value": "compromised" }
      ],
      "action": "Prophylactic MCS strongly recommended. Establish support before wiring. Microaxial pump preferred.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "haem-mcs-last-vessel",
      "domain": "haemodynamics",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "last_remaining_vessel", "op": "is_true" }
      ],
      "action": "Prophylactic MCS strongly recommended before wiring. Microaxial pump or IABP depending on EF. Confirm cardiac surgical backup.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "haem-mcs-severe-ef-high-risk-vessel",
      "domain": "haemodynamics",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "lvef_severe", "op": "is_true" },
        { "field": "vessel", "op": "in", "value": ["LM", "LAD"] }
      ],
      "action": "Prophylactic MCS should be strongly considered. Microaxial pump preferred given large territory at risk and poor haemodynamic reserve.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "IIa", "level": "B" },
      "active": true
    },
    {
      "id": "haem-mcs-consider",
      "domain": "haemodynamics",
      "priority": 2,
      "logic": "any",
      "conditions": [
        { "field": "lvef_severe", "op": "is_true" },
        { "field": "haem_status", "op": "eq", "value": "compromised" }
      ],
      "action": "MCS should be considered. Discuss with team before proceeding. IABP minimum; microaxial pump if EF <35% or large jeopardy territory.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "IIa", "level": "B" },
      "active": true
    }
  ]
}
