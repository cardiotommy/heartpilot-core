{
  "domain": "access",
  "version": "2.0.0",
  "last_reviewed": "2025-01",
  "sources": ["ESC 2018", "ESC 2024", "SCAI", "SCAI 2020"],
  "rules": [
    {
      "id": "acc-radial-preference",
      "domain": "access",
      "priority": 1,
      "logic": "all",
      "conditions": [],
      "action": "Radial access preferred over femoral for all PCI.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "A" },
      "active": true
    },
    {
      "id": "acc-lm-guide-size",
      "domain": "access",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "LM" }
      ],
      "action": "Large-lumen guide (≥7Fr); 8Fr preferred when DK-Crush is planned. Confirm non-dampened waveform before wiring.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2018, "class": "I", "level": "C" },
      "active": true
    },
    {
      "id": "acc-lm-surgical-backup",
      "domain": "access",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "LM" }
      ],
      "action": "Confirm cardiac surgical backup availability before proceeding. Size arterial access for potential MCS insertion.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "C" },
      "active": true
    },
    {
      "id": "acc-tort-ang-guide-extension",
      "domain": "access",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "morphology", "op": "in", "value": ["Tortuous", "Angulated"] }
      ],
      "action": "Consider guide extension catheter (GEC) rather than escalating guide stiffness to improve device deliverability.",
      "caution": null,
      "evidence": { "source": "SCAI", "year": null, "class": null, "level": null },
      "active": true
    },
    {
      "id": "acc-rca-tort-ang-guide",
      "domain": "access",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "RCA" },
        { "field": "morphology", "op": "in", "value": ["Tortuous", "Angulated"] }
      ],
      "action": "Judkins Right first; escalate to Amplatz only if support insufficient. Deep-seating or GEC preferred over aggressive guide engagement.",
      "caution": "Amplatz carries higher ostial trauma risk in tortuous/angulated RCA.",
      "evidence": { "source": "SCAI", "year": null, "class": null, "level": null },
      "active": true
    },
    {
      "id": "acc-graft-guide-selection",
      "domain": "access",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "Graft" }
      ],
      "action": "Prioritise coaxial alignment over backup force. JR4/Hockey Stick for right-sided grafts; AL1/left coronary bypass for left-sided. GEC useful when ostial engagement is inadequate.",
      "caution": null,
      "evidence": { "source": "SCAI", "year": 2020, "class": null, "level": null },
      "active": true
    },
    {
      "id": "acc-graft-native-preference",
      "domain": "access",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "Graft" }
      ],
      "action": "Strongly prefer PCI of the native coronary over the graft if technically feasible.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2018, "class": "IIa", "level": "B" },
      "active": true
    },
    {
      "id": "acc-haem-compromised-guide",
      "domain": "access",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "haem_status", "op": "eq", "value": "compromised" }
      ],
      "action": "Establish MCS before wiring if possible. Plan femoral access for large-bore device. Minimise contrast; treat culprit only if multivessel disease present.",
      "caution": "Do not delay culprit treatment to place MCS if the patient is actively deteriorating — proceed in parallel.",
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "B" },
      "active": true
    }
  ]
}
