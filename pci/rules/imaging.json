{
  "domain": "imaging",
  "version": "2.0.0",
  "last_reviewed": "2025-01",
  "sources": ["ESC 2024", "EBC 2022", "SCAI 2020", "RENOVATE-COMPLEX-PCI", "OCTOBER"],
  "rules": [
    {
      "id": "img-complex-lesion",
      "domain": "imaging",
      "priority": 2,
      "logic": "any",
      "conditions": [
        { "field": "calcification", "op": "eq", "value": "severe" },
        { "field": "lesion_long", "op": "is_true" },
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "Intravascular imaging (IVUS or OCT) recommended. Pre-stent imaging guides sizing and preparation; post-stent imaging confirms expansion and identifies edge dissection.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "A" },
      "active": true
    },
    {
      "id": "img-lm-mandatory",
      "domain": "imaging",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "LM" }
      ],
      "action": "IVUS mandatory. MSA targets: LM ≥8mm², LAD ostium ≥6mm², LCx ostium ≥5mm². Post-dilate with NC balloon if any target unmet.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "img-lm-bif-targets",
      "domain": "imaging",
      "priority": 3,
      "logic": "all",
      "conditions": [
        { "field": "lm_bif", "op": "is_true" }
      ],
      "action": "IVUS mandatory pre- and post-stenting. MSA targets: LM ≥8mm², LAD ostium ≥6mm², LCx ostium ≥5mm².",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "img-prox-lad",
      "domain": "imaging",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "LAD" }
      ],
      "action": "IVUS strongly recommended for proximal LAD. OCT acceptable where detailed plaque characterisation is needed.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": "IIa", "level": "B" },
      "active": true
    },
    {
      "id": "img-ostial",
      "domain": "imaging",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "morphology", "op": "eq", "value": "Ostial" }
      ],
      "action": "IVUS recommended — confirms accurate landing zone, prevents stent protrusion into parent vessel, guides post-dilatation with ostial balloon flaring.",
      "caution": null,
      "evidence": { "source": "ESC", "year": 2024, "class": null, "level": null },
      "active": true
    },
    {
      "id": "img-bif-post-stent",
      "domain": "imaging",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "bifurcation.present", "op": "is_true" }
      ],
      "action": "Post-stent imaging recommended to confirm SB ostial coverage, MV expansion, and absence of proximal edge dissection. IVUS preferred for LM; OCT acceptable elsewhere.",
      "caution": null,
      "evidence": { "source": "EBC", "year": 2022, "class": "I", "level": "B" },
      "active": true
    },
    {
      "id": "img-graft",
      "domain": "imaging",
      "priority": 2,
      "logic": "all",
      "conditions": [
        { "field": "vessel", "op": "eq", "value": "Graft" }
      ],
      "action": "Imaging most useful for confirming stent expansion in large grafts. Not mandated for all SVG PCI but consider when stent sizing is uncertain.",
      "caution": null,
      "evidence": { "source": "SCAI", "year": 2020, "class": null, "level": null },
      "active": true
    }
  ]
}
