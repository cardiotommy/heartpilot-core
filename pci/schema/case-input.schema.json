{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heartpilot.io/pci/schema/case-input.schema.json",
  "title": "HeartPilot PCI Case Input",
  "description": "Normalised case input for the PCI deterministic rule engine. Derived from wizard state; stable regardless of UI changes.",
  "version": "1.0.0",
  "type": "object",
  "required": ["vessel", "calcification", "thrombus", "timi", "lesion_length_mm", "morphology", "lvef", "haem_status"],
  "additionalProperties": false,
  "properties": {

    "vessel": {
      "type": "string",
      "enum": ["LM", "LAD", "LCx", "RCA", "Branch", "Graft"],
      "description": "Target vessel or territory"
    },

    "calcification": {
      "type": "string",
      "enum": ["none", "mild", "moderate", "severe"],
      "description": "Angiographic calcification grade at the lesion"
    },

    "thrombus": {
      "type": "boolean",
      "description": "Angiographic thrombus present"
    },

    "timi": {
      "type": "integer",
      "enum": [0, 1, 2, 3],
      "description": "TIMI flow grade at baseline"
    },

    "lesion_length_mm": {
      "type": "number",
      "minimum": 5,
      "maximum": 60,
      "description": "Estimated lesion length in millimetres"
    },

    "morphology": {
      "type": "string",
      "enum": ["Discrete", "Tubular", "Diffuse", "Ostial", "Angulated", "Tortuous"],
      "description": "Predominant lesion morphology"
    },

    "lvef": {
      "type": "string",
      "enum": ["normal", "mild", "moderate", "severe"],
      "description": "Left ventricular ejection fraction category (normal >55%, mild 45–55%, moderate 30–44%, severe <30%)"
    },

    "haem_status": {
      "type": "string",
      "enum": ["stable", "compromised"],
      "description": "Pre-procedural haemodynamic status"
    },

    "multivessel": {
      "type": "boolean",
      "description": "Multivessel coronary artery disease present",
      "default": false
    },

    "last_remaining_vessel": {
      "type": "boolean",
      "description": "This vessel is the only patent coronary supplying viable myocardium",
      "default": false
    },

    "bifurcation": {
      "type": "object",
      "description": "Bifurcation involvement — omit or set present=false if no bifurcation",
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "medina_prox_mv": { "type": "integer", "enum": [0, 1], "description": "Medina segment 1: proximal main vessel" },
        "medina_dist_mv": { "type": "integer", "enum": [0, 1], "description": "Medina segment 2: distal main vessel" },
        "medina_sb":      { "type": "integer", "enum": [0, 1], "description": "Medina segment 3: side branch ostium" },
        "sb_size": {
          "type": "string",
          "enum": ["lt1.5", "1.5-2.5", "gt2.5"],
          "description": "Side branch reference diameter"
        },
        "sb_angle": {
          "type": "string",
          "enum": ["acute", "moderate", "obtuse"],
          "description": "Side branch take-off angle (acute <45°, moderate 45–70°, obtuse >70°)"
        }
      }
    }
  },

  "$defs": {
    "_computed_notes": {
      "description": "Fields the engine derives at evaluation time — not set by the wizard",
      "lesion_long":     "lesion_length_mm > 20",
      "lesion_vlong":    "lesion_length_mm > 30",
      "timi_zero":       "timi === 0",
      "timi_impaired":   "timi < 3",
      "lvef_reduced":    "lvef in [moderate, severe]",
      "lvef_severe":     "lvef === severe",
      "haem_compromised":"haem_status === compromised",
      "sb_large":        "bifurcation.sb_size === gt2.5",
      "sb_ostial":       "bifurcation.medina_sb === 1",
      "lm_bif":          "vessel === LM && bifurcation.present === true"
    }
  }
}
